# Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=deepseek-r1:7b
EMBEDDING_MODEL=nomic-embed-text

# LLM 参数
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_MAX_TOKENS=2048

# RAG 参数
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=5

# ChromaDB
CHROMA_PERSIST_DIR=./data/vectordb
CHROMA_COLLECTION_NAME=knowledge_base

# 知识文档源目录
KNOWLEDGE_SOURCE_DIR=/Users/wei.tao/Desktop/Data Confluence

# 文档同步间隔（秒）
SYNC_INTERVAL=300

# API 服务
API_HOST=0.0.0.0
API_PORT=8000

# 日志
LOG_LEVEL=INFO
